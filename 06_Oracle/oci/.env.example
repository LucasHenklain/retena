# Copie para ".env" (nesta pasta oci/ ou em 06_Oracle/) e preencha. NUNCA versione o .env real.
# Lido por conexao.py e exportar_para_object_storage.py; variaveis ja exportadas no ambiente tem prioridade.
# Adaptado do EduRetain (equipe Retena): .env.example + config.py.

# ============================ MODO ============================
# local | autonomous | auto  (auto = autonomous se ORACLE_WALLET_DIR preenchido ou DSN com "tcps"; senao local)
ORACLE_MODO=auto

# ===================== 1) MODO LOCAL (Oracle Free 26ai em Docker - padrao do pacote) =====================
ORACLE_USER=STARTUP
ORACLE_PASSWORD=Startup2026
ORACLE_DSN=localhost:1521/FREEPDB1

# ===================== 2) MODO AUTONOMOUS (descomente e ajuste; comente o bloco local) =====================
# Usuario de aplicacao criado pelo runbook (README.md, passo 3) - nao usar ADMIN no dia a dia
#ORACLE_USER=RETENA
#ORACLE_PASSWORD=troque-esta-senha
#
# (a) mTLS com wallet (recomendado - funciona com "Secure access from everywhere"):
#     ORACLE_DSN = alias do tnsnames.ora dentro da wallet (_high para carga/treino; _medium/_low para APEX/BI)
#ORACLE_DSN=retenadb_high
#ORACLE_WALLET_DIR=C:\wallets\retenadb
# Somente se a wallet NAO tiver ewallet.pem (wallets antigas): senha definida no download da wallet
#ORACLE_WALLET_PASSWORD=
#
# (b) TLS sem wallet (exige mTLS desligado no banco -> so possivel com Access type restrito por IP/VCN):
#     copie o "Connection String" da aba TLS em Database Connection e deixe ORACLE_WALLET_DIR vazio
#ORACLE_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=xxxxxxxx_retenadb_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
#ORACLE_WALLET_DIR=

# ===================== 3) OCI Object Storage (exportar_para_object_storage.py) =====================
# Perfil em ~/.oci/config (gerado por "oci setup config" ou manualmente - README.md, passo 4)
OCI_CONFIG_PROFILE=DEFAULT
# Namespace da tenancy (Storage > Buckets, topo da pagina). Se vazio, o script descobre via get_namespace()
OCI_NAMESPACE=
OCI_BUCKET_NAME=retena-lms
# Prefixo/pasta dentro do bucket onde os arquivos de eventos sao gravados
OCI_OBJECT_PREFIX=eventos_lms/
# OCID do compartment - so necessario para --criar-bucket (padrao: tenancy/root)
OCI_COMPARTMENT_OCID=
